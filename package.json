{
  "name": "zeluza-smart-note",
  "displayName": "Zeluza - A Smart Note",
  "description": "Annotate any code range with smart notes — no inline comments. View on hover, manage in sidebar.",
  "version": "0.1.1",
  "publisher": "Wolowys",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zeluza-smart-note.addNote",
        "title": "Add Note",
        "category": "Zeluza"
      },
      {
        "command": "zeluza-smart-note.editNote",
        "title": "Edit Note",
        "category": "Zeluza"
      },
      {
        "command": "zeluza-smart-note.deleteNote",
        "title": "Delete Note",
        "category": "Zeluza"
      },
      {
        "command": "zeluza-smart-note.goToNote",
        "title": "Go to Note",
        "category": "Zeluza"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zeluza-smart-note.addNote",
          "when": "editorHasSelection",
          "group": "zeluza@1"
        }
      ],
      "commandPalette": [
        {
          "command": "zeluza-smart-note.addNote",
          "when": "editorHasSelection"
        },
        {
          "command": "zeluza-smart-note.editNote",
          "when": "false"
        },
        {
          "command": "zeluza-smart-note.deleteNote",
          "when": "false"
        },
        {
          "command": "zeluza-smart-note.goToNote",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zeluza-smart-note.addNote",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorHasSelection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeluza-smart-note",
          "title": "Zeluza",
          "icon": "media/logo.png"
        }
      ]
    },
    "views": {
      "zeluza-smart-note": [
        {
          "type": "webview",
          "id": "zeluza-smart-note.sidebar",
          "name": "Zeluza"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
